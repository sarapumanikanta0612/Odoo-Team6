# Copy to .env.local to override. Do not put secrets here; every VITE_* value is
# bundled into the browser code.

# Where the Vite dev server proxies /api requests. Default: http://localhost:8080
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional. Call the backend directly instead of through the proxy. The page's
# origin must then be listed in the backend's app.cors.allowed-origins.
# VITE_API_BASE_URL=http://localhost:8080
